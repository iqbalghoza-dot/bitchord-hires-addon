{
  "id": "app.bitchord.hires-lossless",
  "name": "Hi-Res Lossless Audio",
  "version": "2.0.0",
  "resources": [
    "search",
    "stream"
  ],
  "minAppVersion": 39,
  "allowDownloads": 1,
  "checkValidLossless": 0,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "lossless",
      "options": [
        { "label": "Hi-Res Lossless (FLAC)", "value": "lossless" },
        { "label": "High (AAC/M4A)", "value": "high" }
      ]
    }
  ]
}
