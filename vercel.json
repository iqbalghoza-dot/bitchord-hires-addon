{
  "version": 2,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/search/:path*", "destination": "/api/index.js?action=search&route=:path*" },
    { "source": "/search", "destination": "/api/index.js?action=search" },
    { "source": "/catalog/:path*", "destination": "/api/index.js?action=search&route=:path*" },
    { "source": "/meta/:path*", "destination": "/api/index.js?action=meta&route=:path*" },
    { "source": "/stream/:path*", "destination": "/api/index.js?action=stream&route=:path*" }
  ]
}
