{
  "version": 2,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/search/:path*",
      "destination": "/api/search.js"
    },
    {
      "source": "/catalog/:type/:id/:extra.json",
      "destination": "/api/catalog.js"
    },
    {
      "source": "/catalog/:type/:id.json",
      "destination": "/api/catalog.js"
    },
    {
      "source": "/meta/:type/:id.json",
      "destination": "/api/meta.js"
    },
    {
      "source": "/stream/:type/:id.json",
      "destination": "/api/stream.js"
    }
  ]
}
