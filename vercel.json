{
  "version": 2,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/search/:type/:query.json", "destination": "/api/search.js?type=:type&q=:query" },
    { "source": "/search/:type/:query", "destination": "/api/search.js?type=:type&q=:query" },
    { "source": "/search", "destination": "/api/search.js" },
    { "source": "/catalog/:type/:id/search=:query.json", "destination": "/api/search.js?type=:type&q=:query" },
    { "source": "/catalog/:type/:id/:extra.json", "destination": "/api/search.js?type=:type&extra=:extra" },
    { "source": "/catalog/:type/:id.json", "destination": "/api/search.js?type=:type" },
    { "source": "/meta/:type/:id.json", "destination": "/api/meta.js?type=:type&id=:id" },
    { "source": "/stream/:type/:id.json", "destination": "/api/stream.js?type=:type&id=:id" }
  ]
}
